---
import { getCollection } from 'astro:content';
import '../../styles/global.css';

/* 扉页（designs/v2/title.html 定稿移植）：竖排大字碑名 + 展签元信息。 */
export async function getStaticPaths() {
  const published = await getCollection('steles', (e) => e.data.status === 'published');
  return published.map((e) => ({ params: { id: e.data.id }, props: { entry: e.data } }));
}

const { entry } = Astro.props;
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.title} · 扉頁</title>
  </head>
  <body>
    <header class="topbar">
      <a class="seal double" href="/">讀帖</a>
      <span class="meta">{entry.title} · 扉頁</span>
      <div class="tools">
        <a class="tool-btn" href="/">目錄</a>
        <a class="tool-btn" href={`/${entry.id}/read`}>閱讀</a>
        <a class="tool-btn" href={`/${entry.id}/colophon`}>跋</a>
      </div>
    </header>

    <div class="stage">
      <article class="book frame">
        <!-- 展签在左，大字碑名在右（竖排书习惯） -->
        <aside class="label" aria-label="展簽元信息">
          <div class="field">
            <span class="k">朝代</span>
            <span class="v">{entry.dynasty} · {entry.year}</span>
          </div>
          <div class="field">
            <span class="k">撰文</span>
            <span class="v">{entry.author}</span>
          </div>
          <div class="field">
            <span class="k">集書</span>
            <span class="v">{entry.calligrapher}</span>
          </div>
          <div class="field">
            <span class="k">書體</span>
            <span class="v">{entry.script}</span>
          </div>
          {entry.stone && (
            <div class="field">
              <span class="k">原石</span>
              <span class="v">{entry.stone}</span>
            </div>
          )}
        </aside>

        <div class="title-block">
          <h1>{entry.title}</h1>
          {entry.alias && <p class="aka">{entry.alias}</p>}
        </div>

        <div class="enter">
          <a href={`/${entry.id}/read`}>進入閱讀</a>
          <span class="hint">正文{entry.sections?.length ?? ''}段 · 句對翻頁</span>
        </div>
      </article>
    </div>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px 24px 20px;
    min-height: 0;
    background:
      radial-gradient(ellipse at 50% 40%, #3A3A3A 0%, transparent 55%),
      linear-gradient(180deg, var(--env-mid) 0%, var(--env-floor) 100%);
  }
  .book {
    background-color: var(--paper);
    background-image:
      radial-gradient(ellipse at 18% 22%, rgba(70, 50, 30, 0.04) 0%, transparent 42%),
      radial-gradient(ellipse at 78% 68%, rgba(50, 40, 25, 0.03) 0%, transparent 48%);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    width: min(760px, 70vw);
    height: min(800px, 84vh);
    min-height: 560px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 56px;
    padding: 48px 64px 72px;
  }
  /* 竖排大字碑名 — 偏右 */
  .title-block {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    height: 78%;
    justify-content: center;
  }
  .title-block h1 {
    font-family: var(--kaiti);
    font-size: clamp(44px, 5.6vh, 58px);
    font-weight: 500;
    letter-spacing: 0.42em;
    line-height: 1.1;
    color: var(--ink);
  }
  .title-block .aka {
    font-family: var(--songti);
    font-size: 15px;
    letter-spacing: 0.28em;
    color: var(--gloss);
  }

  /* 展签：横排键值，整体竖条，朱线分隔 */
  .label {
    writing-mode: horizontal-tb;
    border-left: 1.5px solid var(--zhu);
    padding: 8px 0 8px 22px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-self: center;
    max-width: 14em;
  }
  .field .k {
    display: block;
    font-family: var(--hei);
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--zhu);
    margin-bottom: 6px;
  }
  .field .v {
    display: block;
    font-family: var(--songti);
    font-size: 15px;
    letter-spacing: 0.1em;
    line-height: 1.75;
    color: var(--ink);
  }

  .enter {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .enter a {
    font-family: var(--kaiti);
    font-size: 16px;
    letter-spacing: 0.35em;
    color: var(--zhu);
    border-bottom: 1px solid rgba(156, 42, 32, 0.4);
    padding-bottom: 4px;
  }
  .enter a:hover { border-bottom-color: var(--zhu); }
  .enter .hint {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.15em;
  }

  @media (max-width: 720px) {
    .book {
      width: 92vw;
      height: auto;
      min-height: 70vh;
      flex-direction: column;
      padding: 36px 28px 80px;
      gap: 28px;
    }
    .title-block { height: auto; }
    .label {
      border-left: none;
      border-top: 1.5px solid var(--zhu);
      padding: 18px 0 0;
      max-width: 100%;
      width: 100%;
    }
  }
</style>
