---
import { getCollection } from 'astro:content';
import '../styles/global.css';

/* 目录页（designs/v2/index.html 定稿移植，数据驱动）：
   published 可点入扉页；planned 灰置只显名目，无路由。 */
const entries = (await getCollection('steles')).sort((a, b) => a.data.listOrder - b.data.listOrder);

const groups: Array<{ label: string; items: typeof entries }> = [];
for (const e of entries) {
  const label = e.data.group ?? e.data.dynasty;
  let g = groups.find((x) => x.label === label);
  if (!g) {
    g = { label, items: [] };
    groups.push(g);
  }
  g.items.push(e);
}

const yearShort = (year: string) => year.replace(/（[^）]*）/g, '');
---

<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>讀帖 · 碑帖目錄</title>
  </head>
  <body>
    <header class="topbar">
      <a class="seal double" href="/" title="讀帖">讀帖</a>
      <span class="meta">碑帖目錄 · 臨池深讀</span>
    </header>

    <main class="page">
      <div class="masthead">
        <span class="seal double" aria-hidden="true">讀帖</span>
        <h1>碑帖目錄</h1>
      </div>
      <p class="lede">一句原文，跟一句釋義，逐頁而讀。釋不離經，如古籍集注本。以下按朝代分組；灰置者為計劃中未收錄。</p>
      <div class="rule"></div>

      {groups.map((g) => (
        <section class="group">
          <div class="group-h">
            <h2 class="dyn">{g.label}</h2>
          </div>
          <div class="list">
            {g.items.map((e) => {
              const cell = (
                <>
                  <span class="name">
                    {e.data.title}
                    {e.data.status === 'planned' && <span class="badge">計劃中</span>}
                  </span>
                  <span class="meta-cell">{yearShort(e.data.year)}</span>
                  <span class="meta-cell">{e.data.calligrapher}</span>
                  <span class="script">{e.data.script}</span>
                </>
              );
              return e.data.status === 'published' ? (
                <a class="item" href={`/${e.data.id}/`}>{cell}</a>
              ) : (
                <div class="item planned">{cell}</div>
              );
            })}
          </div>
        </section>
      ))}

      <p class="foot">原文自標點，釋義自產，不據在版權注本。<br />收錄隨臨池進程，次第補全。</p>
    </main>
  </body>
</html>

<style>
  .page {
    max-width: 920px;
    margin: 28px auto 40px;
    padding: 48px 36px 56px;
    background-color: var(--paper);
    background-image:
      radial-gradient(ellipse at 18% 22%, rgba(70, 50, 30, 0.04) 0%, transparent 42%),
      radial-gradient(ellipse at 78% 68%, rgba(50, 40, 25, 0.03) 0%, transparent 48%);
    border: 1px solid rgba(46, 36, 24, 0.22);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }
  .masthead {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 8px;
  }
  .masthead .seal.double {
    width: 52px;
    height: 52px;
    font-size: 18px;
    letter-spacing: 0.22em;
    writing-mode: vertical-rl;
    padding: 6px 0;
  }
  .masthead h1 {
    font-family: var(--kaiti);
    font-size: 36px;
    font-weight: 500;
    letter-spacing: 0.42em;
    line-height: 1.2;
  }
  .lede {
    margin-top: 14px;
    font-family: var(--songti);
    font-size: 14px;
    color: var(--gloss);
    letter-spacing: 0.08em;
    line-height: 1.9;
    max-width: 36em;
  }
  .rule {
    height: 1px;
    background: var(--hair);
    margin: 36px 0 28px;
  }
  .group { margin-bottom: 40px; }
  .group-h { margin-bottom: 14px; }
  .group-h .dyn {
    font-family: var(--kaiti);
    font-size: 18px;
    letter-spacing: 0.28em;
    color: var(--zhu);
  }
  .list { border-top: 1px solid var(--hair); }
  .item {
    display: grid;
    grid-template-columns: minmax(10em, 1.4fr) 5.5em 8em 4em;
    gap: 12px;
    align-items: baseline;
    padding: 14px 6px;
    border-bottom: 1px solid var(--hair);
    font-family: var(--songti);
    transition: background 0.15s;
  }
  a.item:hover { background: rgba(34, 26, 18, 0.06); }
  a.item:hover .name { color: var(--zhu); }
  .item .name {
    font-family: var(--kaiti);
    font-size: 20px;
    letter-spacing: 0.18em;
    transition: color 0.15s;
  }
  .item .meta-cell {
    font-size: 13px;
    color: var(--gloss);
    letter-spacing: 0.06em;
  }
  .item .script {
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--ink);
  }
  .item.planned {
    opacity: 0.48;
    pointer-events: none;
    cursor: default;
  }
  .item.planned .name { color: var(--muted); }
  .badge {
    display: inline-block;
    margin-left: 10px;
    font-family: var(--hei);
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--muted);
    border: 1px solid rgba(138, 126, 104, 0.45);
    padding: 1px 6px;
    vertical-align: 2px;
  }
  .foot {
    margin-top: 48px;
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.12em;
    line-height: 2;
  }
  @media (max-width: 720px) {
    .item {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
    }
    .item .name { grid-column: 1 / -1; }
  }
</style>
